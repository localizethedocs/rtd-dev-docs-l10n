msgid "The Read the Docs code base is deployed as three instances:"
msgstr ""

#: ../../../tests.rst:114
msgid "Main: where you can see the dashboard."
msgstr ""

#: ../../../tests.rst:115
msgid "Build: where the builds happen."
msgstr ""

#: ../../../tests.rst:116
msgid "Serve/proxito: it is in charge of serving the documentation pages."
msgstr ""

